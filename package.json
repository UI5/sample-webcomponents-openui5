{
  "name": "sample-webcomponents-openui5",
  "version": "1.0.0",
  "description": "A Todo sample application built with OpenUI5/SAPUI5 and UI5 Web Components",
  "private": true,
  "scripts": {
    "start": "ui5 serve --open index.html",
    "build": "ui5 build --clean-dest",
    "ts-typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ui5/cli": "^4.0.0",
    "ui5-tooling-modules": "^3.37.0",
    "ui5-tooling-transpile": "^3.12.0",
    "ui5-middleware-livereload": "^3.3.0",
    "typescript": "^5.5.0",
    "@types/openui5": "^1.120.0"
  },
  "dependencies": {
    "@ui5/webcomponents": "^2.2.0",
    "@ui5/webcomponents-fiori": "^2.2.0",
    "@ui5/webcomponents-icons": "^2.2.0"
  }
}
